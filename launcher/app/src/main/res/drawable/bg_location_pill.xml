<?xml version="1.0" encoding="utf-8"?>
<!-- Same look as the weather cards (weather_pill_bg), so the text stays readable when selected. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
            <stroke android:width="1.5dp" android:color="#FFFFFFFF" />
            <corners android:radius="14dp" />
            <padding
                android:left="14dp"
                android:top="5dp"
                android:right="14dp"
                android:bottom="5dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#80121A29" />
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
            <corners android:radius="14dp" />
            <padding
                android:left="14dp"
                android:top="5dp"
                android:right="14dp"
                android:bottom="5dp" />
        </shape>
    </item>
</selector>
